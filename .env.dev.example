# Native development only. Compose continues to use .env.
# Copy to .env.dev and set the password chosen when creating the local PostgreSQL role.
# Replace the password placeholder, then run bin/dev --check before starting.
DB_URL=jdbc:postgresql://localhost:5432/arc
DB_USER=arc
DB_PASSWORD=replace-with-the-password-you-chose
# Use distinct, available ports. For native apps alongside Docker, try 3081/8081.
ARC_WEB_PORT=3080
ARC_API_PORT=8080

# Optional source host policy, using the same settings as the backend.
ARC_HTTP_ALLOWED_HOSTS=
ARC_HTTP_PRIVATE_HOSTS=

# Literal KEY=value entries only; no export, $VAR or $(command) expansion.
# Configure JAVA_HOME/PATH in your shell as described in README.
