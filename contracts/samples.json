        {
          "id": "discount",
          "type": "FORMULA",
          "label": "Apply discount",
          "position": {
            "x": 280.0,
            "y": 160.0
          },
          "expression": "round(amount * (1 - rate), 2)",
          "output": "discounted",
          "ruleId": null,
          "version": null,
          "bindings": null
        },
        {
          "id": "result",
