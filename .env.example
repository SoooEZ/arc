COMPOSE_PROJECT_NAME=arc
ARC_WEB_PORT=3080
ARC_API_PORT=8080
POSTGRES_DB=arc
POSTGRES_USER=arc
POSTGRES_PASSWORD=arc-local-development

# Optional comma-separated HTTP host restrictions. Empty allows public hosts.
ARC_HTTP_ALLOWED_HOSTS=
# Explicit internal service hostnames, if needed. Private addresses otherwise blocked.
ARC_HTTP_PRIVATE_HOSTS=

# Optional Rails backend settings (use compose.rails.yaml)
RAILS_MAX_THREADS=5
